AXIORHUB_PUBLIC_URL=https://agent.example.com
# Adresse du code source affichée dans « À propos » (obligation AGPL si vous modifiez le logiciel) ; vide = dépôt de référence
AXIORHUB_SOURCE_URL=
AXIORHUB_PORT=8626
# Port interne fixe ; distinct du port publié sur l’hôte.
AXIORHUB_LISTEN_PORT=8626
# Proxy sur l’hôte Docker : résolution de sa passerelle exacte, jamais *.
# Pour un proxy dans un autre conteneur, renseigner son adresse exacte.
AXIORHUB_TRUSTED_PROXY=auto-gateway
AXIORHUB_BIND_ADDRESS=127.0.0.1
# Premier administrateur sur /signup AVEC le code privé data/auth/bootstrap-token.
# Les suivants se créent dans « Comptes ».
AXIORHUB_ALLOW_SIGNUP=false
AXIORHUB_THREADS=24
AXIORHUB_DATA_DIR=/data
AXIORHUB_INTERNAL_API_TOKEN=replace-with-a-long-random-secret
TZ=Europe/Paris
AXIORHUB_OLLAMA_URL=http://host.docker.internal:11434
AXIORHUB_OLLAMA_MODEL=qwen3:8b
AXIORHUB_EMBEDDING_MODEL=qwen3-embedding:0.6b
AXIORHUB_IMAP_HOST=imap.example.com
AXIORHUB_IMAP_PORT=993
AXIORHUB_IMAP_USERNAME=user@example.com
AXIORHUB_IMAP_PASSWORD=replace-me
AXIORHUB_IMAP_DRAFTS=Drafts
AXIORHUB_IMAP_SENT=Sent
AXIORHUB_FROM_ADDRESS=user@example.com
AXIORHUB_FROM_NAME=Cabinet exemple
AXIORHUB_NEXTCLOUD_URL=https://cloud.example.com
AXIORHUB_NEXTCLOUD_USERNAME=user
AXIORHUB_NEXTCLOUD_PASSWORD=replace-me
AXIORHUB_NEXTCLOUD_ROOT=/Dossiers
AXIORHUB_ROUNDCUBE_URL=https://mail.example.com
AXIORHUB_OPENWEBUI_URL=https://ai.example.com
# La production reste désactivée au premier démarrage Docker. Testez d'abord
# IMAP, Nextcloud et les modèles, puis activez-la dans Paramètres → Automatismes.
AXIORHUB_PRODUCTION_ENABLED=false
AXIORHUB_AUTOMATIC_MAIL_DRAFTS=false
AXIORHUB_AUTOMATIC_LEGAL_PROJECTS=false
AXIORHUB_AUTOMATIC_INTERNAL_FILES=false
# Mises à jour distantes : laisser l’URL vide tant que la clé publique
# data/update-minisign.pub n’a pas été installée et vérifiée.
AXIORHUB_UPDATE_CHANNEL=stable
AXIORHUB_UPDATE_METADATA_URL=
AXIORHUB_SMTP_HOST=
AXIORHUB_SMTP_PORT=587
AXIORHUB_SMTP_STARTTLS=true
AXIORHUB_SMTP_USERNAME=
AXIORHUB_SMTP_PASSWORD=
AXIORHUB_SMTP_FROM=no-reply@example.com

# 5.6.8 : choix TTS au premier démarrage uniquement ; ensuite Connexions dans l’interface.
AXIORHUB_SPEECH_PROVIDER=espeak
AXIORHUB_SPEECH_URL=http://kokoro:8880
AXIORHUB_SPEECH_VOICE=ff_siwis
AXIORHUB_SPEECH_MODEL=kokoro
# Extension Compose facultative : renseigner un tag ou digest vérifié, jamais latest.
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:v0.1.4

# Agents documentaires : amorçage facultatif, chemins séparés par un point-virgule.
# Chaque chemin doit être inclus dans AXIORHUB_NEXTCLOUD_ROOT ; profil et règles
# s'activent dans l'interface, pas par une simple variable d'environnement.
AXIORHUB_DOCUMENT_INCOMING_PATHS=
# De préférence configurer OAuth depuis Connexions (secret en coffre).
AXIORHUB_GOOGLE_CLIENT_ID=
AXIORHUB_GOOGLE_CLIENT_SECRET=
# Remplacer par l'URL EXACTE de cette installation et l'autoriser dans Google.
AXIORHUB_GOOGLE_REDIRECT_URI=https://agent.example.com/api440/m568/google/callback
