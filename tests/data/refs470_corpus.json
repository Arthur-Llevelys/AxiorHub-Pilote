     "start": "2001-01-01",
     "end": "2019-07-01",
     "state": "ABROGE",
     "text": "Ancienne rédaction fictive du licenciement économique.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000209"
    }
   ]
  },
