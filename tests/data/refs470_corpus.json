{
 "as_of": "2026-09-30",
 "articles": [
  {
   "code": "Code civil",
   "number": "1240",
   "versions": [
    {
     "id": "LEGIARTI000000000100",
     "start": "2016-10-01",
     "end": "",
     "state": "VIGUEUR",
     "text": "Tout fait quelconque de l'homme, qui cause à autrui un dommage, oblige celui par la faute duquel il est arrivé à le réparer.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000100"
    }
   ]
  },
  {
   "code": "Code civil",
   "number": "1103",
   "versions": [
    {
     "id": "LEGIARTI000000000101",
     "start": "2016-10-01",
     "end": "",
     "state": "VIGUEUR",
     "text": "Les contrats légalement formés tiennent lieu de loi à ceux qui les ont faits.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000101"
    }
   ]
  },
  {
   "code": "Code civil",
   "number": "1104",
   "versions": [
    {
     "id": "LEGIARTI000000000102",
     "start": "2016-10-01",
     "end": "",
     "state": "VIGUEUR",
     "text": "Les contrats doivent être négociés, formés et exécutés de bonne foi.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000102"
    }
   ]
  },
  {
   "code": "Code de procédure civile",
   "number": "700",
   "versions": [
    {
     "id": "LEGIARTI000000000103",
     "start": "2001-01-01",
     "end": "",
     "state": "VIGUEUR",
     "text": "Le juge condamne la partie tenue aux dépens ou qui perd son procès à payer à l'autre partie la somme qu'il détermine.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000103"
    }
   ]
  },
  {
   "code": "Code de commerce",
   "number": "L441-10",
   "versions": [
    {
     "id": "LEGIARTI000000000104",
     "start": "2001-01-01",
     "end": "",
     "state": "VIGUEUR",
     "text": "Les conditions de règlement doivent obligatoirement préciser les conditions d application et le taux des pénalités de retard.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000104"
    }
   ]
  },
  {
   "code": "Code de procédure civile",
   "number": "56",
   "versions": [
    {
     "id": "LEGIARTI000000000105",
     "start": "2001-01-01",
     "end": "",
     "state": "VIGUEUR",
     "text": "L'assignation contient à peine de nullité les mentions prescrites par l'article 54.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000105"
    }
   ]
  },
  {
   "code": "Code de procédure civile",
   "number": "768",
   "versions": [
    {
     "id": "LEGIARTI000000000106",
     "start": "2001-01-01",
     "end": "",
     "state": "VIGUEUR",
     "text": "Les conclusions comprennent distinctement un exposé des faits et de la procédure.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000106"
    }
   ]
  },
  {
   "code": "Code de commerce",
   "number": "L110-3",
   "versions": [
    {
     "id": "LEGIARTI000000000107",
     "start": "2001-01-01",
     "end": "",
     "state": "VIGUEUR",
     "text": "A l'égard des commerçants, les actes de commerce peuvent se prouver par tous moyens.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000107"
    }
   ]
  },
  {
   "code": "Code du travail",
   "number": "L1234-1",
   "versions": [
    {
     "id": "LEGIARTI000000000108",
     "start": "2001-01-01",
     "end": "",
     "state": "VIGUEUR",
     "text": "Lorsque le licenciement n est pas motivé par une faute grave, le salarié a droit à un préavis.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000108"
    }
   ]
  },
  {
   "code": "Code de la consommation",
   "number": "L212-1",
   "versions": [
    {
     "id": "LEGIARTI000000000109",
     "start": "2001-01-01",
     "end": "",
     "state": "VIGUEUR",
     "text": "Dans les contrats conclus entre professionnels et consommateurs, sont abusives les clauses qui créent un déséquilibre significatif.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000109"
    }
   ]
  },
  {
   "code": "Code civil",
   "number": "1382",
   "versions": [
    {
     "id": "LEGIARTI000000000200",
     "start": "1804-03-21",
     "end": "2016-10-01",
     "state": "ABROGE",
     "text": "Tout fait quelconque de l'homme, qui cause à autrui un dommage, oblige celui par la faute duquel il est arrivé à le réparer.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000200"
    }
   ]
  },
  {
   "code": "Code civil",
   "number": "1134",
   "versions": [
    {
     "id": "LEGIARTI000000000201",
     "start": "1804-03-21",
     "end": "2016-10-01",
     "state": "ABROGE",
     "text": "Les conventions légalement formées tiennent lieu de loi à ceux qui les ont faites.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000201"
    }
   ]
  },
  {
   "code": "Code civil",
   "number": "1147",
   "versions": [
    {
     "id": "LEGIARTI000000000202",
     "start": "1804-03-21",
     "end": "2016-10-01",
     "state": "ABROGE",
     "text": "Le débiteur est condamné au paiement de dommages et intérêts en cas d'inexécution.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000202"
    }
   ]
  },
  {
   "code": "Code civil",
   "number": "1383",
   "versions": [
    {
     "id": "LEGIARTI000000000203",
     "start": "1804-03-21",
     "end": "2016-10-01",
     "state": "ABROGE",
     "text": "Chacun est responsable du dommage qu'il a causé non seulement par son fait, mais encore par sa négligence.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000203"
    }
   ]
  },
  {
   "code": "Code de commerce",
   "number": "L441-6",
   "versions": [
    {
     "id": "LEGIARTI000000000204",
     "start": "2001-01-01",
     "end": "2019-07-01",
     "state": "ABROGE",
     "text": "Les conditions de règlement précisent les pénalités applicables.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000204"
    }
   ]
  },
  {
   "code": "Code civil",
   "number": "1165",
   "versions": [
    {
     "id": "LEGIARTI000000000205",
     "start": "1804-03-21",
     "end": "2016-10-01",
     "state": "ABROGE",
     "text": "Les conventions n'ont d'effet qu'entre les parties contractantes.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000205"
    }
   ]
  },
  {
   "code": "Code civil",
   "number": "1315",
   "versions": [
    {
     "id": "LEGIARTI000000000206",
     "start": "1804-03-21",
     "end": "2016-10-01",
     "state": "ABROGE",
     "text": "Celui qui réclame l'exécution d'une obligation doit la prouver.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000206"
    }
   ]
  },
  {
   "code": "Code civil",
   "number": "1184",
   "versions": [
    {
     "id": "LEGIARTI000000000207",
     "start": "1804-03-21",
     "end": "2016-10-01",
     "state": "ABROGE",
     "text": "La condition résolutoire est toujours sous-entendue dans les contrats synallagmatiques.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000207"
    }
   ]
  },
  {
   "code": "Code de procédure civile",
   "number": "1317",
   "versions": [
    {
     "id": "LEGIARTI000000000208",
     "start": "2001-01-01",
     "end": "2019-07-01",
     "state": "ABROGE",
     "text": "Ancienne rédaction fictive.",
     "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000000000208"
    }
   ]
  },
  {
   "code": "Code du travail",
   "number": "L1233-3",
   "versions": [
    {
