<?xml version="1.0" encoding="utf-8"?>
<!-- Tests unitaires sans serveur Nextcloud (API publique OCP en dépendance de développement) : composer install puis
     vendor/bin/phpunit -c phpunit-unit.xml. Les tests d'installation réelle utilisent phpunit.xml dans un serveur Nextcloud. -->
<phpunit bootstrap="vendor/autoload.php" colors="true" failOnWarning="true">
	<testsuites>
		<testsuite name="unit">
			<directory>tests/Unit</directory>
		</testsuite>
	</testsuites>
</phpunit>
