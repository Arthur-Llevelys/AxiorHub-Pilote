[Unit]
Description=AxiorHub Pilote — mise à jour signée depuis la page des versions GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -B /usr/local/lib/axiorhub-mail-agent/miseajour.py --executer
TimeoutStartSec=50min
UMask=0077
