#!/usr/bin/env bash
set -euo pipefail
task_cmd="${1:-status}"
if [[ $# -eq 0 ]]; then set -- status; fi
case "$task_cmd" in
  configure|mode|discover|link|update|rollback)
    if [[ $EUID -ne 0 ]]; then
      echo 'Cette commande se lance avec sudo.' >&2
      exit 2
    fi
    if [[ "$task_cmd" == update ]]; then shift; exec /usr/bin/python3 /opt/axiorhub-mail-agent/current/updater.py "$@"; fi
    if [[ "$task_cmd" == rollback ]]; then exec /usr/bin/python3 /opt/axiorhub-mail-agent/current/upgrade.py --rollback; fi
    exec /usr/bin/python3 /opt/axiorhub-mail-agent/current/manage.py "$@"
    ;;
  *)
    if [[ $EUID -eq 0 ]]; then
      exec /usr/sbin/runuser -u axiorhub-mail -- /usr/bin/python3 /opt/axiorhub-mail-agent/current/manage.py "$@"
    fi
    exec /usr/bin/python3 /opt/axiorhub-mail-agent/current/manage.py "$@"
    ;;
esac
