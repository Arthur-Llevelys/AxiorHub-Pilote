[Unit]
Description=AxiorHub assistant courriel — lecture et brouillons IMAP
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/axiorhub-mail-agent/config.json

[Service]
Type=oneshot
User=axiorhub-mail
Group=axiorhub-mail
WorkingDirectory=/opt/axiorhub-mail-agent/current
ExecStart=/usr/bin/python3 /opt/axiorhub-mail-agent/current/manage.py run
UMask=0077
StateDirectory=axiorhub-mail-agent
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/axiorhub-mail-agent
MemoryMax=2G
CPUQuota=100%
Nice=10
TimeoutStartSec=45min
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
