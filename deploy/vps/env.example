# AxiorHub 5.6.0 — réglages du VPS. Copiez ce fichier en « .env » (install-vps.sh le fait et génère les secrets).
# Ne publiez JAMAIS le fichier .env : il contient des mots de passe.

# --- Noms de domaine (enregistrements DNS A/AAAA pointant vers ce serveur) ---
DOMAIN_AGENT=agent.votre-cabinet.fr
DOMAIN_CLOUD=cloud.votre-cabinet.fr
DOMAIN_MAIL=webmail.votre-cabinet.fr
DOMAIN_OFFICE=office.votre-cabinet.fr
# Adresse pour les avis Let's Encrypt (expiration des certificats)
LETSENCRYPT_EMAIL=admin@votre-cabinet.fr
TZ=Europe/Paris

# --- Messagerie du cabinet (hébergeur existant), pour Roundcube ---
IMAP_HOST=imap.votre-hebergeur.fr
IMAP_PORT=993
SMTP_HOST=smtp.votre-hebergeur.fr
SMTP_PORT=587

# --- Nextcloud ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=a-generer
MYSQL_PASSWORD=a-generer
MYSQL_ROOT_PASSWORD=a-generer

# --- OnlyOffice ---
ONLYOFFICE_JWT_SECRET=a-generer

# --- AxiorHub ---
AXIORHUB_PUBLIC_URL=https://agent.votre-cabinet.fr
# Adresse du code source affichée dans « À propos » (obligation AGPL si vous modifiez le logiciel) ; vide = dépôt de référence
AXIORHUB_SOURCE_URL=
AXIORHUB_PORT=8626
AXIORHUB_DATA_DIR=/data
# Inscriptions publiques fermées : le premier compte (administrateur) se crée sur /signup, les autres dans « Comptes ».
AXIORHUB_ALLOW_SIGNUP=false
AXIORHUB_INTERNAL_API_TOKEN=a-generer
AXIORHUB_THREADS=24
# IA locale (profil « ollama ») : http://ollama:11434 ; sinon laisser et choisir une IA externe dans l'assistant d'installation.
AXIORHUB_OLLAMA_URL=http://ollama:11434
AXIORHUB_OLLAMA_MODEL=qwen3:8b
AXIORHUB_EMBEDDING_MODEL=qwen3-embedding:0.6b
AXIORHUB_ROUNDCUBE_URL=https://webmail.votre-cabinet.fr
AXIORHUB_PRODUCTION_ENABLED=false
AXIORHUB_AUTOMATIC_MAIL_DRAFTS=false
AXIORHUB_AUTOMATIC_LEGAL_PROJECTS=false
AXIORHUB_AUTOMATIC_INTERNAL_FILES=false
AXIORHUB_UPDATE_CHANNEL=stable
AXIORHUB_UPDATE_METADATA_URL=
# Envoi des liens « mot de passe oublié » (facultatif)
AXIORHUB_SMTP_HOST=
AXIORHUB_SMTP_PORT=587
AXIORHUB_SMTP_STARTTLS=true
AXIORHUB_SMTP_USERNAME=
AXIORHUB_SMTP_PASSWORD=
AXIORHUB_SMTP_FROM=no-reply@votre-cabinet.fr

# Profils facultatifs : « ollama » pour l'IA locale (serveur avec beaucoup de mémoire, idéalement une carte graphique)
COMPOSE_PROFILES=
