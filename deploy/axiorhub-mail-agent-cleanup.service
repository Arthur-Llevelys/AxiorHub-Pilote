[Unit]
Description=Expiration des rapports locaux de l’assistant courriel
ConditionPathExists=/etc/axiorhub-mail-agent/config.json

[Service]
Type=oneshot
User=axiorhub-mail
Group=axiorhub-mail
ExecStart=/usr/bin/python3 /opt/axiorhub-mail-agent/current/manage.py cleanup --days 30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/axiorhub-mail-agent
