[Unit]
Description=Interface du cabinet AxiorHub Courriel
After=network-online.target
ConditionPathExists=/etc/axiorhub-mail-agent/ui-auth.json

[Service]
Type=simple
User=axiorhub-mail
Group=axiorhub-mail
WorkingDirectory=/opt/axiorhub-mail-agent/current
ExecStart=/opt/axiorhub-mail-agent/ui-venv/bin/python /opt/axiorhub-mail-agent/current/web.py serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/axiorhub-mail-agent
MemoryMax=512M

[Install]
WantedBy=multi-user.target
