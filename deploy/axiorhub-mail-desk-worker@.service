[Unit]
Description=AxiorHub worker complémentaire %i
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/axiorhub-mail-agent/config.json
# 5.6.109 : au-delà de 5 démarrages en 10 minutes, systemd cesse de relancer (plus de boucle de redémarrage)
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=axiorhub-mail
Group=axiorhub-mail
WorkingDirectory=/opt/axiorhub-mail-agent/current
ExecStart=/usr/bin/python3 /opt/axiorhub-mail-agent/current/web.py worker --worker-id %i
Restart=on-failure
RestartSec=15
# 5.6.109 : code 78 (base illisible, agent/secours56109.CODE_SORTIE) : arrêt voulu, jamais relancé automatiquement
RestartPreventExitStatus=78
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/axiorhub-mail-agent
MemoryHigh=1536M
MemoryMax=2G
CPUQuota=100%
Nice=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
